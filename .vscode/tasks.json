{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Tests hôte",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/test/host/run_tests.sh"],
			"options": { "shell": { "executable": "/bin/bash", "args": ["-c"] } },
			"group": { "kind": "test", "isDefault": true },
			"presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
			"problemMatcher": [
				{ "base": "$gcc", "fileLocation": "absolute" },
				{
					"owner": "doctest",
					"fileLocation": "absolute",
					"pattern": {
						"regexp": "^(.*):(\\d+): ERROR: (.*)$",
						"file": 1,
						"line": 2,
						"message": 3
					}
				}
			]
		},
		{
			"label": "Compiler tests hôte",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/test/host/run_tests.sh", "--build-only"],
			"options": { "shell": { "executable": "/bin/bash", "args": ["-c"] } },
			"group": "build",
			"presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
			"problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
		}
	]
}
